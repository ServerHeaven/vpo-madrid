---
// Built as dist/404.html, which GitHub Pages serves for any unknown path: links must be absolute.
import Base from '../layouts/Base.astro';
import { url } from '../lib/rutas';
---

<Base titulo="Página no encontrada" descripcion="La dirección que has abierto no existe en esta web.">
  <h1 class="text-2xl font-bold">Página no encontrada</h1>
  <p class="mt-2 max-w-prose">
    La dirección que has abierto no existe. Puede que esté mal escrita o que la ficha ya no se publique.
  </p>
  <p class="mt-4 flex flex-wrap gap-3">
    <a class="boton" href={url()}>Ir al buscador</a>
    <a class="boton-secundario" href={url('fuentes/')}>Ver las fuentes</a>
  </p>
</Base>
