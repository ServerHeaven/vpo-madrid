---
// Where a requirement comes from, with the "unverified general value" warning.
import { ORIGENES, type Origen } from '../../lib/requisitos';
import type { ReglaPrograma } from '../../lib/types';

interface Props {
  origen: Origen;
  regla: ReglaPrograma | null;
}

const { origen, regla } = Astro.props;
const colores: Record<Origen, string> = {
  convocatoria: 'bg-green-100 text-green-900',
  manual: 'bg-amber-100 text-amber-900',
  programa: 'bg-blue-100 text-blue-900',
  regimen: 'bg-blue-100 text-blue-900',
  no_exigido: 'bg-green-100 text-green-900',
  desconocido: 'bg-slate-200 text-slate-900',
};
---

<span class="mt-1 flex flex-wrap gap-1">
  <span class={`etiqueta ${colores[origen]}`}>{ORIGENES[origen]}</span>
  {regla && !regla.verificado && <span class="etiqueta bg-amber-100 text-amber-900">Valor general sin verificar</span>}
</span>
